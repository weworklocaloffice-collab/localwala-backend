# Project Mode
NODE_ENV=development # production # development
# Port number
PORT=3000

# URL of the Mongo DB
MONGODB_URL=mongodb://localwalaAdmin:Localwala2025DB@127.0.0.1:27017/foodbite?authSource=admin

# JWT
# JWT secret key
JWT_SECRET=yourjwtsecretgoeshere
JWT_EXPIRES_IN=1d
# Number of minutes after which an access token expires
JWT_ACCESS_EXPIRATION_MINUTES=1600
# Number of days after which a refresh token expires
JWT_REFRESH_EXPIRATION_DAYS=365
# Number of minutes after which a reset password token expires
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
# Number of minutes after which a verify email token expires
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10
#Cookies Name for Web Routes
JWT_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_COOKIE_MAX_AGE_MS=86400000
JWT_COOKIE_DOMAIN=
JWT_COOKIE_SAME_SITE=
JWT_COOKIE_SECURE=auto
# CORS URLS
CLIENT_ORIGINS=http://localhost:4200,https://admin.localwala.tech,https://localwala.tech

# Server Timezone for accurate time management
SERVER_TIMEZONE=Asia/Kolkata
# for file upload
FOLDER_PUBLIC=./public/
# upload max file size in bytes. below is 1MB = 1 * 1024 * 1024
MAX_UPLOAD_FILE_SIZE=1048576
# prepend upload filename? random_string like Qwe123, millisecond like 1519211810362, leave it empty for no prepend
PREPEND_UPLOAD_FILE_NAME_METHOD=millisecond
# if above is random_string, set the length of the random string
PREPEND_UPLOAD_FILE_NAME_RANDOM_STRING_LENGTH=10
# allow file type. See a list of MIME at https://developer.mozilla.org/en-US/docs/Web/HTTP/Basics_of_HTTP/MIME_types/Common_types
ALLOW_UPLOAD_FILE_TYPE=image/png,image/jpg,image/jpeg,image/gif,image/ico,image/x-icon,image/bmp,image/vnd.microsoft.icon,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv

# Real Estate — hold policy seed defaults (plan §15.3).
# Policy rates live in the DB (RealEstateHoldPolicy, admin-editable);
# these are only the seed/fallback values, not the source of truth.
REALESTATE_HOLD_DEFAULT_PRINCIPAL=50000
REALESTATE_HOLD_SERVICE_FEE_PERCENT=5.0
REALESTATE_HOLD_DURATION_DAYS=15
REALESTATE_HOLD_GRACE_PERIOD_HOURS=72

# Real Estate — operational limits (fallbacks; DB settings win where present)
REALESTATE_CHECKIN_RADIUS_METERS=200
REALESTATE_SEARCH_MAX_RADIUS_KM=50
REALESTATE_LISTING_MAX_IMAGES=20
REALESTATE_LISTING_MAX_VIDEOS=3

# Real Estate — cron cadence (the scheduler falls back to these defaults)
CRON_REALESTATE_EXPIRY=0 1 * * *
CRON_REALESTATE_HOLD_EXPIRY=30 * * * *
CRON_REALESTATE_REMINDERS=0 */2 * * *
CRON_REALESTATE_ASSIGNMENT=*/10 * * * *
CRON_REALESTATE_COMPLIANCE=0 2 * * 0

# Payments — Razorpay webhook + reconcile sweep (enterprise)
# Webhook secret from Razorpay Dashboard > Settings > Webhooks (do NOT commit live value)
RAZORPAY_WEBHOOK_SECRET=
# Sweep stuck `initiated` intents older than N min, every CRON_PAYMENTS_RECONCILE
CRON_PAYMENTS_RECONCILE=*/15 * * * *
PAYMENTS_RECONCILE_MIN=30
# Pre-expiry pending-payment reminder (window must match app payPendingAmountBeforeMinutesOffCreation)
CRON_PAYMENTS_REMINDER=*/5 * * * *
PAYMENTS_WINDOW_MIN=30



